# Database
DATABASE_URL="postgresql://usuario:password@localhost:5432/fink_db?schema=public"
# En producción, usa el host, usuario y password reales de tu servidor seguro
# Ejemplo: postgresql://usuario:password@produccion-db:5432/fink_db?schema=public

# Server
PORT=4000
# NODE_ENV debe ser 'production' en el servidor de producción
NODE_ENV=development

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=tu_api_key_de_openai

# WhatsApp (opcional según servicio usado)
WHATSAPP_API_URL=https://api.whatsapp.com/
WHATSAPP_API_TOKEN=tu_token_de_whatsapp

# BCV API (Banco Central de Venezuela)
BCV_API_URL=https://pydolarve.org/api/v1/dollar
BCV_BACKUP_API=https://s3.amazonaws.com/dolartoday/data.json

# Fallback values used when external exchange-rate providers are unreachable
# These mirror the real `.env` fallbacks and are useful as developer hints.
# Ajusta o borra estos valores según tu entorno local/CI.
FALLBACK_BCV_USD_TO_BS=233.56
FALLBACK_BCV_EUR_TO_BS=270.33
FALLBACK_BINANCE_USD_TO_BS=342.87
FALLBACK_CUSTOM_USD_TO_BS=250.00

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CORS
# En producción, pon la URL de tu frontend
CORS_ORIGIN=https://tudominio.com

# Email (opcional para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion

# Cron Jobs
ENABLE_CRON_JOBS=true
EXCHANGE_RATE_UPDATE_CRON="0 9 * * *"
DOCUMENT_CHECK_CRON="0 8 * * *"
